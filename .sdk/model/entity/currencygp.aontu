# Entity: currencygp

main: kit: entity: currencygp: {

  alias: field: {}

  fields: {
    amount: {
      h: "Amount"
      n: "amount"
      r: false
      sh: "Original amount to convert"
      t: "`$NUMBER`"
    }
    converted_amount: {
      h: "Converted Amount"
      n: "converted_amount"
      r: false
      sh: "Converted amount in target currency"
      t: "`$NUMBER`"
    }
    exchange_rate: {
      h: "Exchange Rate"
      n: "exchange_rate"
      r: false
      sh: "Exchange rate used for conversion"
      t: "`$NUMBER`"
    }
    from: {
      h: "From"
      n: "from"
      r: false
      sh: "Source currency code"
      t: "`$STRING`"
    }
    timestamp: {
      fo: "date-time"
      h: "Timestamp"
      n: "timestamp"
      r: false
      sh: "Timestamp of the conversion"
      t: "`$STRING`"
    }
    to: {
      h: "To"
      n: "to"
      r: false
      sh: "Target currency code"
      t: "`$STRING`"
    }
  }

  name: "currencygp"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /currency.gp"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 100
                k: "query"
                n: "amount"
                or: "amount"
                r: true
                t: "`$NUMBER`"
              }
              {
                ex: "USD"
                k: "query"
                n: "from"
                or: "from"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "EUR"
                k: "query"
                n: "to"
                or: "to"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/currency.gp"
          q: {
            exist: [
              "amount"
              "from"
              "to"
            ]
          }
          s: [
            {
              lit: "currency.gp"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
