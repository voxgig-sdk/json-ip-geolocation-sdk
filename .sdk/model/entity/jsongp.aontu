# Entity: jsongp

main: kit: entity: jsongp: {

  alias: field: {}

  fields: [
    {
      name: "geoplugin_areaCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_city"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_continentCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_countryCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_countryName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_credit"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_currencyCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_currencyConverter"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "geoplugin_currencySymbol"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_currencySymbol_UTF8"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_dmaCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_latitude"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_longitude"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_region"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_regionCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_regionName"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_request"
      req: false
      type: "`$STRING`"
    }
    {
      name: "geoplugin_status"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "jsongp"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "USD"
                kind: "query"
                name: "base_currency"
                orig: "base_currency"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "8.8.8.8"
                kind: "query"
                name: "ip"
                orig: "ip"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/json.gp"
          parts: [
            "json.gp"
          ]
          select: {
            exist: [
              "base_currency"
              "ip"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
